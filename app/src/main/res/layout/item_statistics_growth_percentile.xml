<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llGrowthPercentile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_r16_surface_stroke_control_border"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGrowthPercentileTitle"
        style="@style/TextAppearance.BabyCare.Heading3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/statistics_growth_percentile_title" />

    <TextView
        android:id="@+id/tvGrowthPercentileContext"
        style="@style/TextAppearance.BabyCare.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorTextHint" />

    <TextView
        android:id="@+id/tvGrowthPercentileNote"
        style="@style/TextAppearance.BabyCare.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/statistics_growth_percentile_note_who"
        android:textColor="?attr/colorTextHint" />

    <TextView
        android:id="@+id/tvGrowthPercentileChartNote"
        style="@style/TextAppearance.BabyCare.Body2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_gap_medium"
        android:text="@string/statistics_growth_percentile_chart_note"
        android:textColor="?attr/colorTextSecondary" />

    <include
        android:id="@+id/itemGrowthPercentileWeight"
        layout="@layout/item_statistics_growth_percentile_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <include
        android:id="@+id/itemGrowthPercentileHeight"
        layout="@layout/item_statistics_growth_percentile_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <include
        android:id="@+id/itemGrowthPercentileHead"
        layout="@layout/item_statistics_growth_percentile_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>


