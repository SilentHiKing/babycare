<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_setting_item_middle_ripple"
    android:minHeight="@dimen/settings_row_min_height"
    android:paddingStart="@dimen/card_padding"
    android:paddingEnd="@dimen/card_padding"
    android:paddingTop="@dimen/settings_row_vertical_padding"
    android:paddingBottom="@dimen/settings_row_vertical_padding">

    <!-- 开关保留独立热区，窄窗下放到完整说明之后，不挤压或截断文案。 -->
    <com.zero.components.widget.AdaptiveTrailingLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/rowTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.BabyCare.Body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:labelFor="@+id/switchToggle"
                android:text="@string/settings_reminder_switch_title"
                android:textColor="?attr/colorTextPrimary"
                tools:text="提醒开关" />

            <TextView
                android:id="@+id/tvSummary"
                style="@style/TextAppearance.BabyCare.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap_small"
                android:includeFontPadding="false"
                android:textColor="?attr/colorTextSecondary"
                android:visibility="gone"
                tools:text="摘要说明"
                tools:visibility="visible" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/min_touch_target"
            android:minHeight="@dimen/min_touch_target"
            android:showText="false"
            android:thumb="@drawable/bg_setting_switch_thumb"
            android:track="@drawable/bg_setting_switch_track"
            app:splitTrack="false" />

    </com.zero.components.widget.AdaptiveTrailingLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
