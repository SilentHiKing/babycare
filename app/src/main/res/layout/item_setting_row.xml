<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_setting_item_middle_ripple"
    android:minHeight="@dimen/settings_row_min_height"
    android:paddingStart="@dimen/card_padding"
    android:paddingEnd="@dimen/card_padding"
    android:paddingTop="@dimen/settings_row_vertical_padding"
    android:paddingBottom="@dimen/settings_row_vertical_padding">

    <!-- 尾部值仅在宽度足够时同行；大字改为下排，标题和说明均完整展示。 -->
    <com.zero.components.widget.AdaptiveTrailingLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/settings_row_arrow_gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivArrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/rowTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.BabyCare.Body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="?attr/colorTextPrimary"
                tools:text="标题" />

            <TextView
                android:id="@+id/tvSummary"
                style="@style/TextAppearance.BabyCare.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap_small"
                android:includeFontPadding="false"
                android:textColor="?attr/colorTextSecondary"
                android:visibility="gone"
                tools:text="摘要内容"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvValue"
            style="@style/TextAppearance.BabyCare.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:includeFontPadding="false"
            android:textColor="?attr/colorTextSecondary"
            tools:text="设置值" />

    </com.zero.components.widget.AdaptiveTrailingLayout>

    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="@dimen/settings_row_arrow_size"
        android:layout_height="@dimen/settings_row_arrow_size"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorTextHint" />

</androidx.constraintlayout.widget.ConstraintLayout>
