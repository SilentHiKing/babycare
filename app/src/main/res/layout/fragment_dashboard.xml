<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <com.zero.components.widget.BaseToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/page_vertical_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="@dimen/dashboard_content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingEnd="@dimen/page_horizontal_padding">

            <!-- ==================== 实时状态卡片 ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap_medium"
                android:background="@drawable/bg_status_card_awake"
                android:outlineProvider="background"
                android:padding="@dimen/card_padding_compact">

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_baby_awake"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    style="@style/TextAppearance.BabyCare.Heading3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/content_gap_large"
                    android:textColor="?attr/colorStatusTextPrimary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivStatusIcon"
                    app:layout_constraintTop_toTopOf="@id/ivStatusIcon"
                    tools:text="宝宝正在睡觉中..." />

                <TextView
                    android:id="@+id/tvStatusTime"
                    style="@style/TextAppearance.BabyCare.Display2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/content_gap_large"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorStatusTextSecondary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivStatusIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvStatusTitle"
                    tools:text="已睡 01:23:45" />

                <!-- 操作行避开图标和完整文本；大字号计时文本可能比图标更高。 -->
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/statusContentBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="ivStatusIcon,tvStatusTitle,tvStatusTime" />

                <TextView
                    android:id="@+id/tvStatusAction"
                    style="@style/TextAppearance.BabyCare.Body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/bg_r999_secondary_bg_default"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/page_horizontal_padding"
                    android:paddingEnd="@dimen/page_horizontal_padding"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/end_record"
                    android:textColor="?attr/colorStatusTextPrimary"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/statusContentBottom"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 窄窗大字号使用纵排，保证标题和生活摘要可完整阅读。 -->
            <com.zero.components.widget.AdaptiveRowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap_large"
                android:orientation="horizontal">

                <!-- 喂养卡片 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardFeeding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_feeding"
                    android:outlineProvider="background"
                    android:padding="@dimen/card_padding_compact">

                <ImageView
                    android:id="@+id/ivFeedingIcon"
                    android:layout_width="@dimen/icon_size_standard"
                    android:layout_height="@dimen/icon_size_standard"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_feeding"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/feeding_primary" />

                    <TextView
                        android:id="@+id/tvFeedingLabel"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/icon_size_standard"
                        android:text="@string/feeding"
                        android:textColor="@color/feeding_primary_dark"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivFeedingIcon"
                        app:layout_constraintTop_toTopOf="@id/ivFeedingIcon" />

                    <!-- 标题随系统字号增高，后续摘要从图标与完整标题的最大底边开始。 -->
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/feedingHeaderBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="ivFeedingIcon,tvFeedingLabel" />

                    <TextView
                        android:id="@+id/tvFeedingSinceTime"
                        style="@style/TextAppearance.BabyCare.Display2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_small"
                        android:textColor="@color/feeding_primary_dark"
                        app:layout_constraintTop_toBottomOf="@id/feedingHeaderBottom"
                        tools:text="2小时15分" />

                    <TextView
                        android:id="@+id/tvFeedingSinceLabel"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/since_last"
                        android:textColor="@color/feeding_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvFeedingSinceTime" />

                    <View
                        android:id="@+id/dividerFeeding"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/surface_stroke_width"
                        android:layout_marginTop="@dimen/content_gap_medium"
                        android:alpha="0.45"
                        android:background="@color/feeding_divider"
                        app:layout_constraintTop_toBottomOf="@id/tvFeedingSinceLabel" />

                    <TextView
                        android:id="@+id/tvFeedingTodayCount"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_small"
                        android:textColor="@color/feeding_primary_dark"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dividerFeeding"
                        tools:text="今日 5次" />

                    <TextView
                        android:id="@+id/tvFeedingTodayDuration"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/feeding_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvFeedingTodayCount"
                        tools:text="共 1小时20分" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 睡眠卡片 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardSleep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_sleep"
                    android:outlineProvider="background"
                    android:padding="@dimen/card_padding_compact">

                <ImageView
                    android:id="@+id/ivSleepIcon"
                    android:layout_width="@dimen/icon_size_standard"
                    android:layout_height="@dimen/icon_size_standard"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sleep"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/sleep_primary" />

                    <TextView
                        android:id="@+id/tvSleepLabel"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/icon_size_standard"
                        android:text="@string/sleeping"
                        android:textColor="@color/sleep_primary_dark"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivSleepIcon"
                        app:layout_constraintTop_toTopOf="@id/ivSleepIcon" />

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/sleepHeaderBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="ivSleepIcon,tvSleepLabel" />

                    <TextView
                        android:id="@+id/tvSleepSinceTime"
                        style="@style/TextAppearance.BabyCare.Display2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_small"
                        android:textColor="@color/sleep_primary_dark"
                        app:layout_constraintTop_toBottomOf="@id/sleepHeaderBottom"
                        tools:text="35分钟" />

                    <TextView
                        android:id="@+id/tvSleepSinceLabel"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/since_last"
                        android:textColor="@color/sleep_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvSleepSinceTime" />

                    <View
                        android:id="@+id/dividerSleep"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/surface_stroke_width"
                        android:layout_marginTop="@dimen/content_gap_medium"
                        android:alpha="0.45"
                        android:background="@color/sleep_divider"
                        app:layout_constraintTop_toBottomOf="@id/tvSleepSinceLabel" />

                    <TextView
                        android:id="@+id/tvSleepTodayCount"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_small"
                        android:textColor="@color/sleep_primary_dark"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dividerSleep"
                        tools:text="今日 3次" />

                    <TextView
                        android:id="@+id/tvSleepTodayDuration"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/sleep_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvSleepTodayCount"
                        tools:text="共 4小时30分" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.zero.components.widget.AdaptiveRowLayout>

            <!-- ==================== 下次预测区域 ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPrediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap_large"
                android:background="@drawable/bg_r16_surface_stroke_control_border"
                android:outlineProvider="background"
                android:padding="@dimen/card_padding_compact">

                <TextView
                    android:id="@+id/tvPredictionSectionTitle"
                    style="@style/TextAppearance.BabyCare.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next_prediction"
                    android:textColor="?attr/colorTextHint"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 喂养预测 -->
                <ImageView
                    android:id="@+id/ivPredictFeeding"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/content_gap_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_feeding"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPredictionSectionTitle"
                    app:tint="@color/feeding_primary" />

                <!-- 先用可读的纵排；真实文字宽度足够时由 Fragment 合为同行。 -->
                <LinearLayout
                    android:id="@+id/rowPredictFeeding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/content_gap_medium"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivPredictFeeding"
                    app:layout_constraintTop_toTopOf="@id/ivPredictFeeding">

                    <TextView
                        android:id="@+id/tvPredictFeedingTime"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorTextPrimary"
                        tools:text="下次喂奶 约 14:30" />

                    <TextView
                        android:id="@+id/tvPredictFeedingRemain"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_small"
                        android:textColor="?attr/colorTextHint"
                        tools:text="还有45分钟" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPredictFeedingEvidence"
                    style="@style/TextAppearance.BabyCare.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/content_gap_medium"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorTextHint"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivPredictFeeding"
                    app:layout_constraintTop_toBottomOf="@id/rowPredictFeeding"
                    tools:text="基于 6 次有效记录间隔" />

                <View
                    android:id="@+id/dividerPredict"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/surface_stroke_width"
                    android:layout_marginTop="@dimen/content_gap_small"
                    android:alpha="0.45"
                    android:background="@color/colorDivider"
                    app:layout_constraintTop_toBottomOf="@id/tvPredictFeedingEvidence" />

                <!-- 睡眠预测 -->
                <ImageView
                    android:id="@+id/ivPredictSleep"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/content_gap_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sleep"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerPredict"
                    app:tint="@color/sleep_primary" />

                <!-- 先用可读的纵排；真实文字宽度足够时由 Fragment 合为同行。 -->
                <LinearLayout
                    android:id="@+id/rowPredictSleep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/content_gap_medium"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivPredictSleep"
                    app:layout_constraintTop_toTopOf="@id/ivPredictSleep">

                    <TextView
                        android:id="@+id/tvPredictSleepTime"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorTextPrimary"
                        tools:text="下次睡觉 约 16:00" />

                    <TextView
                        android:id="@+id/tvPredictSleepRemain"
                        style="@style/TextAppearance.BabyCare.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_small"
                        android:textColor="?attr/colorTextHint"
                        tools:text="还有45分钟" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPredictSleepEvidence"
                    style="@style/TextAppearance.BabyCare.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/content_gap_medium"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorTextHint"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivPredictSleep"
                    app:layout_constraintTop_toBottomOf="@id/rowPredictSleep"
                    tools:text="当前规律较弱，仅供参考" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ==================== 快速记录区域 ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardQuickRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_gap_large"
                android:background="@drawable/bg_r16_surface_stroke_control_border"
                android:outlineProvider="background"
                android:padding="@dimen/card_padding_compact">

                <TextView
                    android:id="@+id/tvQuickRecordSectionTitle"
                    style="@style/TextAppearance.BabyCare.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_record"
                    android:textColor="?attr/colorTextSecondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQuickRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_gap_small"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuickRecordSectionTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.zero.components.widget.PageStateView
        android:id="@+id/pageState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

</androidx.constraintlayout.widget.ConstraintLayout>
