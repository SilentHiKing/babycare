<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <!-- 通用 Toolbar 只承载导航和主操作，宝宝档案对象感放在内容区。 -->
    <com.zero.components.widget.BaseToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:toolbarTitle="@string/babyInfo" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBabyInfo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/settings_content_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="@dimen/settings_content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingTop="@dimen/page_vertical_padding">

            <LinearLayout
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_group_surface_border"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/profileHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="88dp"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:id="@+id/profileAvatarContainer"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_toolbar_identity_avatar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivProfileAvatar"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_baby_default"
                            app:tint="?attr/colorBrandForeground" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvProfileTitle"
                        style="@style/TextAppearance.BabyCare.Heading2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gap_large"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorTextPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/profileAvatarContainer"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="@string/baby_profile_new_title" />

                    <!-- 提示使用完整行宽，并避开头像及长姓名；头部随文字自然增高。 -->
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/profileIdentityBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="profileAvatarContainer,tvProfileTitle" />

                    <TextView
                        android:id="@+id/tvProfileSubtitle"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap_medium"
                        android:includeFontPadding="false"
                        android:text="@string/baby_profile_create_subtitle"
                        android:textColor="?attr/colorTextSecondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/profileIdentityBottom" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvBasicInfoTitle"
                    style="@style/TextAppearance.BabyCare.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="4dp"
                    android:text="@string/baby_profile_basic_info"
                    android:textColor="?attr/colorTextSecondary" />

                <!-- 标签与输入按真实文字宽度排布；窄窗换行，完整日期不再被固定标签列挤掉。 -->
                <com.zero.components.widget.AdaptiveTrailingLayout
                    android:id="@+id/rowName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingTop="@dimen/content_gap_small"
                    android:paddingBottom="@dimen/content_gap_small">

                    <TextView
                        android:id="@+id/labelName"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:labelFor="@+id/etName"
                        android:text="@string/babyName"
                        android:textColor="?attr/colorTextPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etName"
                            style="@style/TextAppearance.BabyCare.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="@dimen/min_touch_target"
                            android:minHeight="@dimen/min_touch_target"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="@string/babyNameHint"
                            android:imeOptions="actionDone"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:padding="0dp"
                            android:singleLine="true"
                            android:textColor="?attr/colorTextPrimary"
                            android:textColorHint="?attr/colorTextHint" />
                    </LinearLayout>
                </com.zero.components.widget.AdaptiveTrailingLayout>

                <View
                    style="@style/divide_horizontal_line"
                    android:layout_marginStart="@dimen/card_padding"
                    android:layout_marginEnd="@dimen/card_padding" />

                <com.zero.components.widget.AdaptiveTrailingLayout
                    android:id="@+id/rowBirthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:background="@drawable/bg_setting_item_middle_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingTop="@dimen/content_gap_small"
                    android:paddingBottom="@dimen/content_gap_small">

                    <TextView
                        android:id="@+id/labelBirthday"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:labelFor="@+id/etBirthday"
                        android:text="@string/babyBirthday"
                        android:textColor="?attr/colorTextPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etBirthday"
                            style="@style/TextAppearance.BabyCare.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="@dimen/min_touch_target"
                            android:minHeight="@dimen/min_touch_target"
                            android:background="@null"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:gravity="center_vertical"
                            android:hint="@string/baby_profile_select_birthday"
                            android:includeFontPadding="false"
                            android:inputType="textMultiLine"
                            android:padding="0dp"
                            android:textColor="?attr/colorTextPrimary"
                            android:textColorHint="?attr/colorTextHint" />

                        <ImageView
                            android:id="@+id/ivBirthdayAction"
                            android:layout_width="@dimen/icon_size_standard"
                            android:layout_height="@dimen/icon_size_standard"
                            android:layout_marginStart="@dimen/content_gap_medium"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar"
                            app:tint="?attr/colorTextSecondary" />
                    </LinearLayout>
                </com.zero.components.widget.AdaptiveTrailingLayout>

                <View
                    style="@style/divide_horizontal_line"
                    android:layout_marginStart="@dimen/card_padding"
                    android:layout_marginEnd="@dimen/card_padding" />

                <com.zero.components.widget.AdaptiveTrailingLayout
                    android:id="@+id/rowGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:background="@drawable/bg_setting_item_middle_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingTop="@dimen/content_gap_small"
                    android:paddingBottom="@dimen/content_gap_small">

                    <TextView
                        android:id="@+id/labelGender"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:labelFor="@+id/etGender"
                        android:text="@string/babyGender"
                        android:textColor="?attr/colorTextPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etGender"
                            style="@style/TextAppearance.BabyCare.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="@dimen/min_touch_target"
                            android:minHeight="@dimen/min_touch_target"
                            android:background="@null"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:gravity="center_vertical"
                            android:hint="@string/please_select"
                            android:includeFontPadding="false"
                            android:inputType="textMultiLine"
                            android:padding="0dp"
                            android:textColor="?attr/colorTextPrimary"
                            android:textColorHint="?attr/colorTextHint" />

                        <ImageView
                            android:id="@+id/ivGenderAction"
                            android:layout_width="@dimen/settings_row_arrow_size"
                            android:layout_height="@dimen/settings_row_arrow_size"
                            android:layout_marginStart="@dimen/content_gap_medium"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="?attr/colorTextHint" />
                    </LinearLayout>
                </com.zero.components.widget.AdaptiveTrailingLayout>

                <TextView
                    android:id="@+id/tvBirthInfoTitle"
                    style="@style/TextAppearance.BabyCare.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="4dp"
                    android:text="@string/baby_profile_birth_info"
                    android:textColor="?attr/colorTextSecondary" />

                <com.zero.components.widget.AdaptiveTrailingLayout
                    android:id="@+id/rowWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingTop="@dimen/content_gap_small"
                    android:paddingBottom="@dimen/content_gap_small">

                    <TextView
                        android:id="@+id/labelWeight"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:labelFor="@+id/etWeight"
                        android:text="@string/babyWeight"
                        android:textColor="?attr/colorTextPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etWeight"
                            style="@style/TextAppearance.BabyCare.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="@dimen/min_touch_target"
                            android:minHeight="@dimen/min_touch_target"
                            android:background="@null"
                            android:digits="0123456789."
                            android:gravity="center_vertical"
                            android:hint="@string/optional"
                            android:includeFontPadding="false"
                            android:inputType="numberDecimal"
                            android:padding="0dp"
                            android:singleLine="true"
                            android:textColor="?attr/colorTextPrimary"
                            android:textColorHint="?attr/colorTextHint" />

                        <TextView
                            android:id="@+id/tvWeightUnit"
                            style="@style/TextAppearance.BabyCare.Body2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/content_gap_medium"
                            android:includeFontPadding="false"
                            android:text="@string/weight_unit"
                            android:textColor="?attr/colorTextSecondary" />
                    </LinearLayout>
                </com.zero.components.widget.AdaptiveTrailingLayout>

                <View
                    style="@style/divide_horizontal_line"
                    android:layout_marginStart="@dimen/card_padding"
                    android:layout_marginEnd="@dimen/card_padding" />

                <com.zero.components.widget.AdaptiveTrailingLayout
                    android:id="@+id/rowHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingTop="@dimen/content_gap_small"
                    android:paddingBottom="@dimen/content_gap_small">

                    <TextView
                        android:id="@+id/labelHeight"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:labelFor="@+id/etHeight"
                        android:text="@string/babyHeight"
                        android:textColor="?attr/colorTextPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etHeight"
                            style="@style/TextAppearance.BabyCare.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="@dimen/min_touch_target"
                            android:minHeight="@dimen/min_touch_target"
                            android:background="@null"
                            android:digits="0123456789."
                            android:gravity="center_vertical"
                            android:hint="@string/optional"
                            android:includeFontPadding="false"
                            android:inputType="numberDecimal"
                            android:padding="0dp"
                            android:singleLine="true"
                            android:textColor="?attr/colorTextPrimary"
                            android:textColorHint="?attr/colorTextHint" />

                        <TextView
                            android:id="@+id/tvHeightUnit"
                            style="@style/TextAppearance.BabyCare.Body2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/content_gap_medium"
                            android:includeFontPadding="false"
                            android:text="@string/height_unit"
                            android:textColor="?attr/colorTextSecondary" />
                    </LinearLayout>
                </com.zero.components.widget.AdaptiveTrailingLayout>

                <View
                    style="@style/divide_horizontal_line"
                    android:layout_marginStart="@dimen/card_padding"
                    android:layout_marginEnd="@dimen/card_padding" />

                <com.zero.components.widget.AdaptiveTrailingLayout
                    android:id="@+id/rowBloodType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:background="@drawable/bg_setting_item_bottom_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingTop="@dimen/content_gap_small"
                    android:paddingBottom="@dimen/content_gap_small">

                    <TextView
                        android:id="@+id/labelBloodType"
                        style="@style/TextAppearance.BabyCare.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:labelFor="@+id/etBloodType"
                        android:text="@string/babyBloodType"
                        android:textColor="?attr/colorTextPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etBloodType"
                            style="@style/TextAppearance.BabyCare.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="@dimen/min_touch_target"
                            android:minHeight="@dimen/min_touch_target"
                            android:background="@null"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:gravity="center_vertical"
                            android:hint="@string/please_select"
                            android:includeFontPadding="false"
                            android:inputType="textMultiLine"
                            android:padding="0dp"
                            android:textColor="?attr/colorTextPrimary"
                            android:textColorHint="?attr/colorTextHint" />

                        <ImageView
                            android:id="@+id/ivBloodTypeAction"
                            android:layout_width="@dimen/settings_row_arrow_size"
                            android:layout_height="@dimen/settings_row_arrow_size"
                            android:layout_marginStart="@dimen/content_gap_medium"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="?attr/colorTextHint" />
                    </LinearLayout>
                </com.zero.components.widget.AdaptiveTrailingLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDelete"
                style="@style/TextAppearance.BabyCare.Body1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_group_surface_border"
                android:gravity="center"
                android:text="@string/delete_baby"
                android:textColor="?attr/semantics_warning_red"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
