<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="?attr/bg_r12_secondary_bg_default"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="16dp">

    <!-- 当前选中标识 -->
    <ImageView
        android:id="@+id/ivSelected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorBrandForeground"
        tools:visibility="visible" />

    <!-- 宝宝头像 -->
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/bg_r999_block_gridview"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_baby_default"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 文字按同一纵向流测量，生日显隐与选中图标改变宽度时不会残留单个约束节点的旧高度。 -->
    <LinearLayout
        android:id="@+id/babyInfoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/ivSelected"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintTop_toTopOf="@id/ivAvatar">

        <TextView
            android:id="@+id/tvName"
            style="@style/TextAppearance.BabyCare.Heading3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorTextPrimary"
            tools:text="小明" />

        <TextView
            android:id="@+id/tvInfo"
            style="@style/TextAppearance.BabyCare.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorTextHint"
            tools:text="♂ 男孩 · 180天" />

        <TextView
            android:id="@+id/tvBirthDate"
            style="@style/TextAppearance.BabyCare.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorTextHint"
            tools:text="出生: 2024-06-28" />

    </LinearLayout>

    <!-- 文字随系统字号自然增高，操作区避开头像和最后一行文字，不再受固定头像高度约束。 -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/babyInfoBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierAllowsGoneWidgets="false"
        app:constraint_referenced_ids="ivAvatar,babyInfoText" />

    <!-- 操作区分隔线 -->
    <include
        android:id="@+id/actionRow"
        layout="@layout/view_card_action_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/babyInfoBottom" />

</androidx.constraintlayout.widget.ConstraintLayout>



