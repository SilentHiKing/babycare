<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flBabyAge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_surface_group_sides_control_border"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/statistics_day_content_inset"
    android:paddingEnd="@dimen/statistics_day_content_inset"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- 缺少生日时使用完整宽度的次级操作，大字号自然换行，不与记录数量争抢宽度。 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddBirthdate"
        style="@style/TextAppearance.BabyCare.Body2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/record_time_field_gap"
        android:minHeight="48dp"
        android:background="@drawable/selector_radio_bg"
        android:backgroundTint="@null"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:stateListAnimator="@null"
        android:text="@string/statistics_add_birthdate_hint"
        android:textAllCaps="false"
        android:textColor="?attr/colorBrandForeground"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/llBabyAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/bg_r999_block_gridview"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_baby_default" />

            <TextView
                android:id="@+id/tvBabyDays"
                style="@style/TextAppearance.BabyCare.Body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/semantics_blue"
                tools:text="已出生 180 天" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRecordCount"
            style="@style/TextAppearance.BabyCare.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:textColor="?attr/colorTextHint"
            tools:text="当天 5 条记录" />

    </LinearLayout>

</LinearLayout>
