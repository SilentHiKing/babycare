<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_surface_group_sides_control_border"
    android:paddingStart="@dimen/statistics_day_content_inset"
    android:paddingEnd="@dimen/statistics_day_content_inset">

    <Space
        android:id="@+id/spaceTop"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:id="@+id/spaceTimelineRail"
        android:layout_width="@dimen/statistics_timeline_rail_width"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 时间放在轨道右侧，避免形成“左时间列 + 右内容列”的割裂阅读路径。 -->
    <TextView
        android:id="@+id/tvTime"
        style="@style/TextAppearance.BabyCare.Body2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:layout_marginStart="@dimen/statistics_timeline_time_gap"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="?attr/colorTextPrimary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/spaceTimelineRail"
        app:layout_constraintTop_toBottomOf="@id/spaceTop"
        tools:text="09:15" />

    <!-- 时间轴线（上） -->
    <View
        android:id="@+id/vTimelineLineTop"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/control_border_default"
        app:layout_constraintBottom_toTopOf="@id/vTimelineDot"
        app:layout_constraintEnd_toEndOf="@id/vTimelineDot"
        app:layout_constraintStart_toStartOf="@id/vTimelineDot"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 时间轴点 -->
    <View
        android:id="@+id/vTimelineDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/circle_white"
        android:backgroundTint="@color/event_diaper"
        app:layout_constraintBottom_toBottomOf="@id/tvTime"
        app:layout_constraintEnd_toEndOf="@id/spaceTimelineRail"
        app:layout_constraintStart_toStartOf="@id/spaceTimelineRail"
        app:layout_constraintTop_toTopOf="@id/tvTime" />

    <!-- 时间轴线（下） -->
    <View
        android:id="@+id/vTimelineLineBottom"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/control_border_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/vTimelineDot"
        app:layout_constraintStart_toStartOf="@id/vTimelineDot"
        app:layout_constraintTop_toBottomOf="@id/vTimelineDot" />

    <!-- 大字号下给整组正文完整阅读宽度，避免类型和测量部位被拆成碎词。 -->
    <com.zero.components.widget.AdaptiveRowLayout
        android:id="@+id/rowTimelineContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/statistics_timeline_content_top_gap"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvTime"
        app:layout_constraintTop_toBottomOf="@id/tvTime">

        <!-- 纵排仅扩展外层槽位，内部图标保持40dp圆形承托。 -->
        <FrameLayout
            android:layout_width="@dimen/statistics_timeline_icon_size"
            android:layout_height="@dimen/statistics_timeline_icon_size">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/statistics_timeline_icon_size"
                android:layout_height="@dimen/statistics_timeline_icon_size"
                android:contentDescription="@null"
                android:padding="8dp"
                android:background="@drawable/bg_event_icon_circle"
                android:backgroundTint="@color/event_diaper_light"
                android:src="@drawable/ic_event_diaper"
                app:tint="@color/event_diaper" />
        </FrameLayout>

        <!-- 文本栈统一承载标题、详情和备注，详情隐藏时备注会自然上移。 -->
        <LinearLayout
            android:id="@+id/llTextContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/statistics_timeline_text_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 健康和成长等类型名称较长，完整换行保留区分记录所需的信息。 -->
            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.BabyCare.Heading3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="?attr/colorTextPrimary"
                tools:text="换尿布（湿）" />

            <!-- 详情信息（可选） -->
            <TextView
                android:id="@+id/tvDetail"
                style="@style/TextAppearance.BabyCare.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorTextSecondary"
                android:visibility="gone"
                tools:text="体温：37.2°C"
                tools:visibility="visible" />

            <!-- 备注（可选） -->
            <TextView
                android:id="@+id/tvNote"
                style="@style/TextAppearance.BabyCare.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorTextHint"
                android:visibility="gone"
                tools:text="备注：颜色正常" />
        </LinearLayout>

    </com.zero.components.widget.AdaptiveRowLayout>

    <Space
        android:id="@+id/spaceBottom"
        android:layout_width="0dp"
        android:layout_height="@dimen/statistics_timeline_item_bottom_gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowTimelineContent" />

</androidx.constraintlayout.widget.ConstraintLayout>


