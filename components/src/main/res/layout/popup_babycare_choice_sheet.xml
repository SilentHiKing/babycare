<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_picker_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/content_gap_medium"
    android:paddingBottom="@dimen/content_gap_medium">

    <View
        android:layout_width="36dp"
        android:layout_height="@dimen/content_gap_small"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:background="@drawable/bg_picker_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/min_touch_target"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingEnd="@dimen/page_horizontal_padding">

        <TextView
            android:id="@+id/tv_cancel"
            style="@style/TextAppearance.BabyCare.Action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/content_gap_medium"
            android:minHeight="@dimen/min_touch_target"
            android:paddingTop="@dimen/content_gap_medium"
            android:paddingBottom="@dimen/content_gap_medium"
            android:gravity="center_vertical"
            android:text="@string/cancel"
            android:textColor="?attr/colorTextSecondary" />

        <TextView
            android:id="@+id/tv_confirm"
            style="@style/TextAppearance.BabyCare.Action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/min_touch_target"
            android:paddingTop="@dimen/content_gap_medium"
            android:paddingBottom="@dimen/content_gap_medium"
            android:gravity="center_vertical|end"
            android:text="@string/confirm"
            android:textColor="?attr/colorBrandForeground" />

    </LinearLayout>

    <!-- 操作区独立测量，只有选项在矮窗口中收缩滚动；两项短列表仍按内容自然增高。 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/choice_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/option_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/content_gap_medium" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
