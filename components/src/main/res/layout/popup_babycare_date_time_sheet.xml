<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_picker_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/content_gap_medium"
    android:paddingBottom="@dimen/content_gap_medium">

    <View
        android:layout_width="36dp"
        android:layout_height="@dimen/content_gap_small"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_picker_drag_handle"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/min_touch_target"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingEnd="@dimen/page_horizontal_padding">

        <TextView
            android:id="@+id/tv_cancel"
            style="@style/TextAppearance.BabyCare.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/min_touch_target"
            android:minHeight="@dimen/min_touch_target"
            android:gravity="center"
            android:padding="@dimen/content_gap_medium"
            android:text="@string/cancel"
            android:textColor="?attr/colorTextSecondary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_confirm"
            style="@style/TextAppearance.BabyCare.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/min_touch_target"
            android:minHeight="@dimen/min_touch_target"
            android:gravity="center"
            android:padding="@dimen/content_gap_medium"
            android:text="@string/confirm"
            android:textColor="?attr/colorBrandForeground" />
    </LinearLayout>

    <!-- 高字号或矮窗口允许分组内容滚动，确认入口始终留在外部。 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/picker_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingEnd="@dimen/page_horizontal_padding">

        <LinearLayout
            android:id="@+id/picker_column_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/picker_date_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list_year"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list_month"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list_day"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/picker_date_selection"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/surface_stroke_width"
                        android:layout_gravity="top"
                        android:background="@color/control_border_default" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/surface_stroke_width"
                        android:layout_gravity="bottom"
                        android:background="@color/control_border_default" />
                </FrameLayout>

                <View
                    android:id="@+id/picker_date_fade_top"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_picker_fade_top"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/picker_date_fade_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_picker_fade_bottom"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <Space
                android:id="@+id/picker_date_time_group_gap"
                android:layout_width="@dimen/content_gap_medium"
                android:layout_height="@dimen/content_gap_medium"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:id="@+id/picker_time_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list_hour"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list_minute"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list_second"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/picker_time_selection"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/surface_stroke_width"
                        android:layout_gravity="top"
                        android:background="@color/control_border_default" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/surface_stroke_width"
                        android:layout_gravity="bottom"
                        android:background="@color/control_border_default" />
                </FrameLayout>

                <View
                    android:id="@+id/picker_time_fade_top"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_picker_fade_top"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/picker_time_fade_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_picker_fade_bottom"
                    android:importantForAccessibility="no" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
